; STM32F103C8: 64 KiB Flash, 20 KiB RAM.
; Last 2 KiB (0x0800F800..0x0800FFFF) belong to settings, never code.
LR_IROM1 0x08000000 0x0000F800 {
  ER_IROM1 0x08000000 0x0000F800 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00005000 {
    .ANY (+RW +ZI)
  }
}
